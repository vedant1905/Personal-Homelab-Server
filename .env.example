# ==============================================================================
# Personal Homelab Server - Global Configuration (.env)
# ==============================================================================
# Copy this file to .env before starting: cp .env.example .env
# Edit values according to your domain, timezone, and network settings.
# ==============================================================================

# --- System & Localization ---
TZ=Etc/UTC
PUID=1000
PGID=1000

# Base directory for persistent data on host (absolute or relative)
DATA_DIR=./data

# --- Domain & Network ---
# Set your domain or local domain (e.g., homelab.local, mylab.net)
DOMAIN_NAME=homelab.local
SERVER_IP=192.168.1.100

# ACME / SSL Email (used for Let's Encrypt certificates if domain is public)
ACME_EMAIL=admin@example.com

# --- Core Service Ports ---
# Reverse Proxy (Caddy)
HTTP_PORT=80
HTTPS_PORT=443

# Homepage Dashboard
HOMEPAGE_PORT=3000

# Container Management (Dockge / Portainer)
DOCKGE_PORT=5001
PORTAINER_PORT=9443

# --- Networking & DNS ---
# AdGuard Home
ADGUARD_WEB_PORT=3001
ADGUARD_DNS_PORT=53

# --- Monitoring ---
# Uptime Kuma
UPTIME_KUMA_PORT=3002
# Glances system monitoring
GLANCES_PORT=61208

# --- Storage & Utilities ---
# Vaultwarden (Bitwarden compatible)
VAULTWARDEN_PORT=8080
VAULTWARDEN_ADMIN_TOKEN=generate_a_secure_random_token_here

# FileBrowser
FILEBROWSER_PORT=8081

# --- Media Services ---
# Jellyfin Media Server
JELLYFIN_PORT=8096
